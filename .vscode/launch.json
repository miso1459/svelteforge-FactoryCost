{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "name": "SvelteKit: 모든 코드 디버깅 (Full Stack)",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "Local:[\\s]+https?://localhost:([0-9]+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ]
}
